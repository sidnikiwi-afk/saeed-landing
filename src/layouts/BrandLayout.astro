---
import '../styles/brand.css';
import { SEO } from 'astro-seo';
import Nav from '../components/brand/Nav.astro';
import Footer from '../components/brand/Footer.astro';

interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
  home?: string;
}

const {
  title,
  description = 'Brackstone answers the calls, captures the enquiries, books the work and chases the follow-ups small UK teams drop when they are busy.',
  noindex = false,
  home = '/preview/',
} = Astro.props;

const siteUrl = 'https://brackstonedigital.co.uk';
const canonicalUrl = new URL(Astro.url.pathname, siteUrl).toString();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <SEO
      title={title}
      description={description}
      canonical={canonicalUrl}
      noindex={noindex}
      nofollow={noindex}
      openGraph={{
        basic: {
          title: title,
          type: 'website',
          image: `${siteUrl}/og-image.png`,
        },
        optional: {
          description: description,
          siteName: 'Brackstone Digital',
          locale: 'en_GB',
        },
      }}
      twitter={{
        card: 'summary_large_image',
        title: title,
        description: description,
        image: `${siteUrl}/og-image.png`,
      }}
    />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preload" href="/fonts/Geist-Variable.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/GeistMono-Variable.woff2" as="font" type="font/woff2" crossorigin />
  </head>
  <body>
    <Nav home={home} />
    <slot />
    <Footer />
  </body>
</html>
