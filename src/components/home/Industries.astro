---
const trades = [
  {
    name: 'Garages and workshops',
    icon: 'spanner',
    line: 'Matches the right technician to the right job, holds the slot, and confirms it by text.',
    points: [
      'Service and MOT bookings taken from calls that used to hit voicemail',
      'Technician availability kept current without a ring-round',
      'Parts and courtesy car questions answered the same way every time',
    ],
  },
  {
    name: 'Estate agents and lettings',
    icon: 'key',
    line: 'Books the viewing, holds the slot, and chases the applicant who never replied.',
    points: [
      'Viewing requests captured out of hours and placed in the diary',
      'Applicants chased on a schedule instead of when someone remembers',
      'Enquiry, property and next step recorded against the right branch',
    ],
  },
  {
    name: 'Trades and field service',
    icon: 'van',
    line: 'Answers while your hands are full, and books the callback before the lead goes cold.',
    points: [
      'Emergency and routine work separated before it reaches your phone',
      'Quote requests captured with the detail you would have asked for',
      'Follow-ups kept visible until the job is won or closed',
    ],
  },
  {
    name: 'Vehicle hire',
    icon: 'car',
    line: 'Takes the hire enquiry, gets the dates down, and passes a clean booking to the desk.',
    points: [
      'Dates, vehicle class and driver details captured on the first call',
      'Out-of-hours enquiries held and actioned at open',
      'Repeat hirers recognised instead of re-explaining themselves',
    ],
  },
];
---
<section class="ind" id="industries">
  <div class="ind-inner">
    <header class="ind-head">
      <span class="ind-eyebrow">Industries</span>
      <h2 class="ind-title">Built around how your trade actually runs.</h2>
      <p class="ind-sub">
        The same engine underneath, shaped to the way each business takes work in. We start where
        your enquiries leak most, then widen out.
      </p>
    </header>

    <div class="ind-grid">
      {trades.map((t) => (
        <article class="card">
          <span class="card-icon" aria-hidden="true">
            {t.icon === 'spanner' && (
              <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M14.7 6.3a4 4 0 0 0 5 5l-9 9a2.8 2.8 0 0 1-4-4l9-9Z"/><path d="M14.7 6.3 17 4"/></svg>
            )}
            {t.icon === 'key' && (
              <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="8" cy="8" r="4"/><path d="M11 11l9 9M17 17l2-2M14 14l2-2"/></svg>
            )}
            {t.icon === 'van' && (
              <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M2 8h11v8H2zM13 11h4l3 3v2h-7z"/><circle cx="6" cy="18" r="1.6"/><circle cx="17" cy="18" r="1.6"/></svg>
            )}
            {t.icon === 'car' && (
              <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M4 15h16v-3l-2-4H6L4 12z"/><circle cx="7.5" cy="17" r="1.5"/><circle cx="16.5" cy="17" r="1.5"/></svg>
            )}
          </span>
          <h3 class="card-name">{t.name}</h3>
          <p class="card-line">{t.line}</p>
          <ul class="card-points">
            {t.points.map((p) => (
              <li>
                <span class="tick" aria-hidden="true">
                  <svg viewBox="0 0 16 16" width="11" height="11" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round"><path d="M3 8.5l3 3 7-7"/></svg>
                </span>
                <span>{p}</span>
              </li>
            ))}
          </ul>
        </article>
      ))}
    </div>

    <p class="ind-foot">
      Working in something close to these? Say what your team keeps dropping and we will tell you
      straight whether we can help.
    </p>
  </div>
</section>

<style>
  @reference "../../styles/global.css";

  .ind {
    background: var(--color-brand-bg);
    padding: 5rem 1.5rem 4rem;
  }
  .ind-inner {
    max-width: 1120px;
    margin: 0 auto;
  }
  .ind-head {
    max-width: 660px;
    margin: 0 auto 3rem;
    text-align: center;
  }
  .ind-eyebrow {
    display: inline-block;
    font-size: 0.76rem;
    font-weight: 600;
    color: var(--color-brand-primary);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin-bottom: 0.8rem;
  }
  .ind-title {
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: clamp(1.8rem, 3.4vw, 2.5rem);
    line-height: 1.12;
    letter-spacing: -0.02em;
    color: var(--color-brand-ink);
    margin: 0 0 0.8rem;
    text-wrap: balance;
  }
  .ind-sub {
    font-size: 1rem;
    line-height: 1.6;
    color: var(--color-brand-muted);
    margin: 0;
  }

  .ind-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.1rem;
  }
  .card {
    background: var(--color-brand-surface);
    border: 1px solid var(--color-brand-line);
    border-radius: 14px;
    padding: 1.6rem 1.5rem;
    transition: border-color 0.2s ease, transform 0.2s ease, box-shadow 0.2s ease;
  }
  .card:hover {
    border-color: color-mix(in srgb, var(--color-brand-primary) 40%, var(--color-brand-line));
    transform: translateY(-2px);
    box-shadow: 0 18px 44px -30px rgba(10, 10, 11, 0.4);
  }
  .card-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    border-radius: 10px;
    background: color-mix(in srgb, var(--color-brand-primary) 10%, transparent);
    color: var(--color-brand-primary);
    margin-bottom: 1rem;
  }
  .card-name {
    font-family: var(--font-heading);
    font-size: 1.08rem;
    font-weight: 600;
    color: var(--color-brand-ink);
    margin: 0 0 0.5rem;
  }
  .card-line {
    font-size: 0.94rem;
    line-height: 1.55;
    color: var(--color-brand-ink);
    margin: 0 0 1.1rem;
  }
  .card-points {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.55rem;
    border-top: 1px solid var(--color-brand-line);
    padding-top: 1.05rem;
  }
  .card-points li {
    display: flex;
    align-items: flex-start;
    gap: 0.55rem;
    font-size: 0.86rem;
    line-height: 1.5;
    color: var(--color-brand-muted);
  }
  .tick {
    flex: none;
    margin-top: 0.2rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 15px;
    height: 15px;
    border-radius: 50%;
    background: color-mix(in srgb, var(--color-brand-accent) 16%, transparent);
    color: var(--color-brand-accent);
  }

  .ind-foot {
    margin: 2.25rem auto 0;
    max-width: 40rem;
    text-align: center;
    font-size: 0.9rem;
    line-height: 1.6;
    color: var(--color-brand-muted);
  }

  @media (max-width: 820px) {
    .ind { padding: 3.75rem 1.25rem 3rem; }
    .ind-grid { grid-template-columns: minmax(0, 1fr); }
  }
</style>
