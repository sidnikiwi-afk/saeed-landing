---
const views = [
  {
    id: 'overview',
    label: 'The day',
    title: 'See the day at a glance',
    body: 'What came in, what got booked, and what still needs a person. The first screen your team opens in the morning.',
    img: '/images/homepage/dashboard-overview-1440x900.png',
  },
  {
    id: 'calls',
    label: 'Conversations',
    title: 'Every conversation, written down',
    body: 'Searchable transcripts and recordings with the summary already done, so nobody has to ask what was agreed.',
    img: '/images/homepage/dashboard-calls-1440x900.png',
  },
  {
    id: 'queue',
    label: 'Follow-ups',
    title: 'Nothing sits and goes quiet',
    body: 'Urgent enquiries stay at the top until someone marks them handled. This is the queue that replaces the sticky notes.',
    img: '/images/homepage/dashboard-queue-1440x900.png',
  },
  {
    id: 'analytics',
    label: 'Patterns',
    title: 'Patterns you can act on',
    body: 'When enquiries peak, what people ask for, and where the work is actually coming from.',
    img: '/images/homepage/dashboard-analytics-1440x900.png',
  },
];
---
<section class="proof" id="proof">
  <div class="proof-inner">
    <header class="proof-head">
      <span class="proof-eyebrow">See it run</span>
      <h2 class="proof-title">Do not take our word for it. Watch it work.</h2>
      <p class="proof-sub">
        Every job the system does is recorded and visible. You are not trusting a black box, you
        are reading back what it did and deciding whether you would have done the same.
      </p>
    </header>

    <div class="tabs" role="tablist" aria-label="Dashboard views">
      {views.map((v, i) => (
        <button
          class={`tab${i === 0 ? ' is-active' : ''}`}
          role="tab"
          aria-selected={i === 0 ? 'true' : 'false'}
          aria-controls={`panel-${v.id}`}
          id={`tab-${v.id}`}
          data-target={v.id}
          type="button"
        >
          {v.label}
        </button>
      ))}
    </div>

    <div class="panels">
      {views.map((v, i) => (
        <div
          class={`panel${i === 0 ? ' is-active' : ''}`}
          id={`panel-${v.id}`}
          role="tabpanel"
          aria-labelledby={`tab-${v.id}`}
          data-panel={v.id}
        >
          <div class="panel-copy">
            <h3 class="panel-title">{v.title}</h3>
            <p class="panel-body">{v.body}</p>
          </div>
          <figure class="panel-shot">
            <div class="shot-chrome" aria-hidden="true"><span></span><span></span><span></span></div>
            <img src={v.img} alt={`${v.label} view of the Brackstone dashboard`} loading="lazy" decoding="async" width="1440" height="900" />
          </figure>
        </div>
      ))}
    </div>

    <p class="proof-foot">
      Want to hear it rather than read about it? We will set up a working line for your business
      and you can try to catch it out.
    </p>
  </div>
</section>

<style>
  @reference "../../styles/global.css";

  .proof {
    background: var(--color-brand-bg);
    padding: 5rem 1.5rem 4.5rem;
  }
  .proof-inner {
    max-width: 1120px;
    margin: 0 auto;
  }
  .proof-head {
    max-width: 660px;
    margin: 0 auto 2.25rem;
    text-align: center;
  }
  .proof-eyebrow {
    display: inline-block;
    font-size: 0.76rem;
    font-weight: 600;
    color: var(--color-brand-primary);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin-bottom: 0.8rem;
  }
  .proof-title {
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: clamp(1.8rem, 3.4vw, 2.5rem);
    line-height: 1.12;
    letter-spacing: -0.02em;
    color: var(--color-brand-ink);
    margin: 0 0 0.8rem;
    text-wrap: balance;
  }
  .proof-sub {
    font-size: 1rem;
    line-height: 1.6;
    color: var(--color-brand-muted);
    margin: 0;
  }

  .tabs {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.4rem;
    margin-bottom: 1.75rem;
  }
  .tab {
    border: 1px solid var(--color-brand-line);
    background: var(--color-brand-surface);
    color: var(--color-brand-muted);
    border-radius: 999px;
    padding: 0.5rem 1.05rem;
    font-family: inherit;
    font-size: 0.85rem;
    font-weight: 500;
    cursor: pointer;
    transition: color 0.18s ease, border-color 0.18s ease, background 0.18s ease;
  }
  .tab:hover { color: var(--color-brand-ink); }
  .tab.is-active {
    background: var(--color-brand-primary);
    border-color: var(--color-brand-primary);
    color: #fff;
  }
  .tab:focus-visible {
    outline: 2px solid var(--color-brand-primary);
    outline-offset: 3px;
  }

  .panel { display: none; }
  .panel.is-active {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    gap: 2.5rem;
    align-items: center;
  }
  .panel-title {
    font-family: var(--font-heading);
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--color-brand-ink);
    margin: 0 0 0.6rem;
    line-height: 1.25;
  }
  .panel-body {
    font-size: 0.95rem;
    line-height: 1.62;
    color: var(--color-brand-muted);
    margin: 0;
  }
  .panel-shot {
    margin: 0;
    border: 1px solid var(--color-brand-line);
    border-radius: 12px;
    overflow: hidden;
    background: var(--color-brand-surface);
    box-shadow: 0 26px 64px -34px rgba(10, 10, 11, 0.42);
  }
  .shot-chrome {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.6rem 0.8rem;
    border-bottom: 1px solid var(--color-brand-line);
  }
  .shot-chrome span {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--color-brand-line);
  }
  .panel-shot img {
    display: block;
    width: 100%;
    height: auto;
  }

  .proof-foot {
    margin: 2.5rem auto 0;
    max-width: 40rem;
    text-align: center;
    font-size: 0.9rem;
    line-height: 1.6;
    color: var(--color-brand-muted);
  }

  @media (max-width: 900px) {
    .proof { padding: 3.75rem 1.25rem 3.25rem; }
    .panel.is-active {
      grid-template-columns: minmax(0, 1fr);
      gap: 1.5rem;
    }
  }
</style>

<script>
  const tabs = document.querySelectorAll<HTMLButtonElement>('.proof .tab');
  const panels = document.querySelectorAll<HTMLElement>('.proof .panel');
  tabs.forEach((tab) => {
    tab.addEventListener('click', () => {
      const target = tab.dataset.target;
      tabs.forEach((t) => {
        const on = t === tab;
        t.classList.toggle('is-active', on);
        t.setAttribute('aria-selected', String(on));
      });
      panels.forEach((p) => p.classList.toggle('is-active', p.dataset.panel === target));
    });
  });
</script>
