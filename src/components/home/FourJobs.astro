---
const jobs = [
  {
    key: 'Answer',
    title: 'Someone picks up',
    body: 'A UK-tuned voice agent answers on the first ring, day or night, asks what your team would ask, and hands over cleanly when a person is needed.',
    meta: 'Voice, out of hours, overflow',
  },
  {
    key: 'Capture',
    title: 'The detail gets written down',
    body: 'Calls, forms, emails and web enquiries land in one place with the name, the job, the urgency and the next step already recorded.',
    meta: 'Calls, forms, inbox, web',
  },
  {
    key: 'Book',
    title: 'It goes in the diary',
    body: 'Slots are checked, held and confirmed against the people and vehicles you actually have free, then written back to your calendar.',
    meta: 'Availability, bookings, reschedules',
  },
  {
    key: 'Chase',
    title: 'Nobody goes quiet',
    body: 'Quotes, callbacks and applicants are followed up on a schedule rather than when someone remembers, and stay visible until they are closed.',
    meta: 'Follow-ups, reminders, pipeline',
  },
];
---
<section class="jobs" id="jobs">
  <div class="jobs-inner">
    <header class="jobs-head">
      <span class="jobs-eyebrow">What it runs</span>
      <h2 class="jobs-title">Four jobs, running while you work.</h2>
      <p class="jobs-sub">
        One enquiry, start to finish. Most teams do all four by hand and drop one or two on the
        busy days. This is the whole point of the thing.
      </p>
    </header>

    <ol class="flow">
      {jobs.map((j) => (
        <li class="job">
          <div class="job-marker" aria-hidden="true"><span class="node"></span></div>
          <div class="job-body">
            <span class="job-key">{j.key}</span>
            <h3 class="job-title">{j.title}</h3>
            <p class="job-text">{j.body}</p>
            <span class="job-meta">{j.meta}</span>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  @reference "../../styles/global.css";

  .jobs {
    background: var(--color-brand-surface);
    border-top: 1px solid var(--color-brand-line);
    border-bottom: 1px solid var(--color-brand-line);
    padding: 5rem 1.5rem;
  }
  .jobs-inner {
    max-width: 1120px;
    margin: 0 auto;
  }
  .jobs-head {
    max-width: 640px;
    margin: 0 auto 3.25rem;
    text-align: center;
  }
  .jobs-eyebrow {
    display: inline-block;
    font-size: 0.76rem;
    font-weight: 600;
    color: var(--color-brand-primary);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin-bottom: 0.8rem;
  }
  .jobs-title {
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: clamp(1.8rem, 3.4vw, 2.5rem);
    line-height: 1.12;
    letter-spacing: -0.02em;
    color: var(--color-brand-ink);
    margin: 0 0 0.8rem;
    text-wrap: balance;
  }
  .jobs-sub {
    font-size: 1rem;
    line-height: 1.6;
    color: var(--color-brand-muted);
    margin: 0;
  }

  .flow {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1.5rem;
  }
  .job {
    display: grid;
    gap: 1rem;
  }
  /* The connector encodes that this is one enquiry moving through, not four features. */
  .job-marker {
    position: relative;
    height: 9px;
    display: flex;
    align-items: center;
  }
  .job-marker::before {
    content: '';
    position: absolute;
    left: 0;
    right: -1.5rem;
    height: 1px;
    background: var(--color-brand-line);
  }
  .job:last-child .job-marker::before { right: 0; }
  .node {
    position: relative;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--color-brand-primary);
    box-shadow: 0 0 0 4px color-mix(in srgb, var(--color-brand-primary) 14%, transparent);
  }
  .job:last-child .node { background: var(--color-brand-accent); box-shadow: 0 0 0 4px color-mix(in srgb, var(--color-brand-accent) 18%, transparent); }

  .job-key {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-brand-primary);
    margin-bottom: 0.55rem;
  }
  .job-title {
    font-family: var(--font-heading);
    font-size: 1.02rem;
    font-weight: 600;
    color: var(--color-brand-ink);
    margin: 0 0 0.5rem;
    line-height: 1.3;
  }
  .job-text {
    font-size: 0.89rem;
    line-height: 1.58;
    color: var(--color-brand-muted);
    margin: 0 0 0.9rem;
  }
  .job-meta {
    display: inline-block;
    font-size: 0.74rem;
    line-height: 1.4;
    color: var(--color-brand-muted);
    border-top: 1px solid var(--color-brand-line);
    padding-top: 0.7rem;
  }

  @media (max-width: 900px) {
    .flow { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .job:nth-child(2) .job-marker::before { right: 0; }
  }
  @media (max-width: 560px) {
    .jobs { padding: 3.75rem 1.25rem; }
    .flow { grid-template-columns: minmax(0, 1fr); gap: 1.75rem; }
    .job .job-marker::before { right: 0; }
  }
</style>
