---
---
<footer class="footer">
  <div class="footer-inner">
    <div class="footer-left">
      <a href="/" class="footer-logo" aria-label="Brackstone home">
        <span class="f-logo-mark" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" xmlns="http://www.w3.org/2000/svg">
            <rect x="2" y="2" width="20" height="20" rx="6" fill="currentColor"/>
            <path d="M8 7.5h5.2c1.7 0 2.9 1 2.9 2.4 0 1-.6 1.7-1.5 2 1.1.3 1.8 1.2 1.8 2.4 0 1.6-1.2 2.7-3.1 2.7H8V7.5Zm2.1 3.6h2.7c.8 0 1.3-.4 1.3-1s-.5-1-1.3-1h-2.7v2Zm0 4h2.9c.9 0 1.4-.4 1.4-1.1 0-.7-.5-1.1-1.4-1.1h-2.9v2.2Z" fill="#fff"/>
          </svg>
        </span>
        <span class="f-logo-text">Brackstone</span>
      </a>
      <p class="footer-tagline">The work small teams drop when they are busy, running on its own.</p>
    </div>
    <div class="footer-right">
      <div class="footer-col">
        <span class="footer-col-label">Industries</span>
        <a href="#industries">Garages and workshops</a>
        <a href="#industries">Estate agents and lettings</a>
        <a href="#industries">Trades and field service</a>
        <a href="#industries">Vehicle hire</a>
      </div>
      <div class="footer-col">
        <span class="footer-col-label">The system</span>
        <a href="#jobs">What it runs</a>
        <a href="#proof">See it run</a>
      </div>
      <div class="footer-col">
        <span class="footer-col-label">Company</span>
        <a href="/contact">Get in touch</a>
        <a href="/privacy">Privacy</a>
      </div>
    </div>
  </div>
  <div class="footer-bottom">
    <span>&copy; 2026 Brackstone Digital. All rights reserved.</span>
    <span class="footer-legal">Brackstone Digital Limited, registered in England &amp; Wales, company no. 17159711. Registered office: 71-75 Shelton Street, Covent Garden, London, WC2H 9JQ.</span>
  </div>
</footer>

<style>
  @reference "../../styles/global.css";

  .footer {
    background: var(--color-brand-bg);
    border-top: 1px solid var(--color-brand-line);
    padding: 3.25rem 1.5rem 2rem;
  }
  .footer-inner {
    max-width: 1120px;
    margin: 0 auto;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 2.5rem;
    padding-bottom: 2.25rem;
    border-bottom: 1px solid var(--color-brand-line);
  }
  .footer-logo {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    text-decoration: none;
    margin-bottom: 0.75rem;
  }
  .f-logo-mark {
    display: inline-flex;
    color: var(--color-brand-primary);
  }
  .f-logo-text {
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 1rem;
    color: var(--color-brand-ink);
  }
  .footer-tagline {
    font-size: 0.85rem;
    line-height: 1.55;
    color: var(--color-brand-muted);
    margin: 0;
    max-width: 20rem;
  }
  .footer-right {
    display: flex;
    flex-wrap: wrap;
    gap: 3rem;
  }
  .footer-col {
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
  }
  .footer-col-label {
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: var(--color-brand-ink);
    margin-bottom: 0.2rem;
  }
  .footer-col a {
    font-size: 0.86rem;
    color: var(--color-brand-muted);
    text-decoration: none;
    transition: color 0.18s ease;
  }
  .footer-col a:hover { color: var(--color-brand-ink); }
  .footer-col a:focus-visible {
    outline: 2px solid var(--color-brand-primary);
    outline-offset: 3px;
    border-radius: 3px;
  }

  .footer-bottom {
    max-width: 1120px;
    margin: 0 auto;
    padding-top: 1.5rem;
    font-size: 0.78rem;
    color: var(--color-brand-muted);
  }
  .footer-legal {
    display: block;
    margin-top: 0.5rem;
    font-size: 0.72rem;
    opacity: 0.62;
    line-height: 1.5;
  }

  @media (max-width: 700px) {
    .footer-right { gap: 2rem; }
  }
</style>
