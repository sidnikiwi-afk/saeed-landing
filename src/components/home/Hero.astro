---
const dropped = [
  { time: '08:12', label: 'Missed call, no voicemail', caught: 'Answered' },
  { time: '10:40', label: 'Quote request sat in the inbox', caught: 'Captured' },
  { time: '13:05', label: 'Viewing enquiry, nobody free', caught: 'Booked' },
  { time: '16:47', label: 'Callback promised, not made', caught: 'Chased' },
  { time: '21:19', label: 'Out of hours, phone off', caught: 'Answered' },
];
---
<section class="hero">
  <div class="hero-bg" aria-hidden="true"></div>
  <div class="hero-inner">
    <div class="hero-copy">
      <div class="hero-eyebrow">
        <span class="dot" aria-hidden="true"></span>
        <span>For UK garages, letting agents, trades and hire desks</span>
      </div>
      <h1 class="hero-headline">
        The work your business drops when it is busy,
        <span class="grad">running on its own.</span>
      </h1>
      <p class="hero-sub">
        Brackstone answers the calls, captures the enquiries, books the work and chases the
        follow-ups your team never gets back to. Built around how your trade actually runs,
        not bolted on top of it.
      </p>
      <div class="hero-cta-row">
        <a href="/contact" class="btn-primary">
          Book a 15-minute teardown
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
        <a href="#proof" class="btn-ghost">See it run</a>
      </div>
      <p class="hero-note">
        We map where your enquiries leak, and show you what we would automate first. No pitch deck.
      </p>
    </div>

    <aside class="ledger" aria-labelledby="ledger-title">
      <div class="ledger-head">
        <h2 class="ledger-title" id="ledger-title">One week, one small team</h2>
        <span class="ledger-tag">Example</span>
      </div>
      <ul class="ledger-list">
        {dropped.map((d, i) => (
          <li class="row" style={`--i:${i}`}>
            <span class="row-time">{d.time}</span>
            <span class="row-label">{d.label}</span>
            <span class="row-state">
              <span class="state-dropped">Dropped</span>
              <span class="state-caught">
                <svg viewBox="0 0 16 16" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 8.5l3 3 7-7"/></svg>
                {d.caught}
              </span>
            </span>
          </li>
        ))}
      </ul>
      <p class="ledger-foot">
        Illustration of the enquiries a small team loses in a normal week, and which of the four
        jobs picks each one up.
      </p>
    </aside>
  </div>
</section>

<style>
  @reference "../../styles/global.css";

  .hero {
    position: relative;
    padding: 9rem 1.5rem 4.5rem;
    overflow: hidden;
    background: var(--color-brand-bg);
  }
  .hero-bg {
    position: absolute;
    inset: -10% -5% 0 -5%;
    background:
      radial-gradient(55% 45% at 25% 0%, rgba(110, 72, 240, 0.15), transparent 70%),
      radial-gradient(40% 40% at 90% 25%, rgba(0, 200, 150, 0.08), transparent 70%);
    pointer-events: none;
  }
  .hero-bg::after {
    content: '';
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(var(--color-brand-line) 1px, transparent 1px),
      linear-gradient(90deg, var(--color-brand-line) 1px, transparent 1px);
    background-size: 56px 56px;
    mask-image: radial-gradient(70% 60% at 40% 25%, #000 0%, transparent 75%);
    -webkit-mask-image: radial-gradient(70% 60% at 40% 25%, #000 0%, transparent 75%);
    opacity: 0.5;
  }
  .hero-inner {
    position: relative;
    z-index: 2;
    max-width: 1180px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
    gap: 3.5rem;
    align-items: center;
  }

  .hero-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.35rem 0.8rem 0.35rem 0.6rem;
    border: 1px solid var(--color-brand-line);
    background: var(--color-brand-surface);
    border-radius: 999px;
    font-size: 0.78rem;
    font-weight: 500;
    color: var(--color-brand-muted);
    margin-bottom: 1.5rem;
  }
  .dot {
    flex: none;
    align-self: flex-start;
    margin-top: 0.42rem;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-brand-accent);
  }
  .hero-headline {
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: clamp(2.15rem, 4.4vw, 3.4rem);
    line-height: 1.06;
    letter-spacing: -0.02em;
    color: var(--color-brand-ink);
    margin: 0 0 1.15rem;
    text-wrap: balance;
  }
  .grad {
    display: block;
    background: linear-gradient(100deg, var(--color-brand-primary), var(--color-brand-accent));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .hero-sub {
    font-size: 1.06rem;
    line-height: 1.62;
    color: var(--color-brand-muted);
    margin: 0 0 2rem;
    max-width: 33rem;
  }
  .hero-cta-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-bottom: 1.1rem;
  }
  .btn-primary,
  .btn-ghost {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.85rem 1.4rem;
    border-radius: 9px;
    font-size: 0.95rem;
    font-weight: 500;
    text-decoration: none;
    transition: background 0.18s ease, border-color 0.18s ease, transform 0.18s ease;
  }
  .btn-primary {
    background: var(--color-brand-primary);
    color: #fff;
  }
  .btn-primary:hover {
    background: var(--color-brand-primary-2);
    transform: translateY(-1px);
  }
  .btn-ghost {
    border: 1px solid var(--color-brand-line);
    background: var(--color-brand-surface);
    color: var(--color-brand-ink);
  }
  .btn-ghost:hover {
    border-color: var(--color-brand-primary);
  }
  .btn-primary:focus-visible,
  .btn-ghost:focus-visible {
    outline: 2px solid var(--color-brand-primary);
    outline-offset: 3px;
  }
  .hero-note {
    font-size: 0.85rem;
    line-height: 1.55;
    color: var(--color-brand-muted);
    margin: 0;
    max-width: 30rem;
  }

  /* Signature: the dropped-work ledger */
  .ledger {
    background: var(--color-brand-surface);
    border: 1px solid var(--color-brand-line);
    border-radius: 14px;
    padding: 1.35rem 1.35rem 1.15rem;
    box-shadow: 0 24px 60px -32px rgba(10, 10, 11, 0.35);
  }
  .ledger-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-bottom: 0.9rem;
    border-bottom: 1px solid var(--color-brand-line);
  }
  .ledger-title {
    font-family: var(--font-heading);
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--color-brand-ink);
    margin: 0;
  }
  .ledger-tag {
    font-size: 0.68rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-brand-muted);
    border: 1px solid var(--color-brand-line);
    border-radius: 999px;
    padding: 0.2rem 0.55rem;
  }
  .ledger-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .row {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: 0.85rem;
    padding: 0.78rem 0;
    border-bottom: 1px solid var(--color-brand-line);
  }
  .row:last-child { border-bottom: 0; }
  .row-time {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-variant-numeric: tabular-nums;
    color: var(--color-brand-muted);
  }
  .row-label {
    font-size: 0.88rem;
    line-height: 1.4;
    color: var(--color-brand-ink);
  }
  .row-state {
    position: relative;
    display: grid;
    justify-items: end;
    min-width: 5.75rem;
  }
  .state-dropped,
  .state-caught {
    grid-area: 1 / 1;
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-size: 0.76rem;
    font-weight: 500;
    white-space: nowrap;
  }
  .state-dropped { color: var(--color-brand-muted); }
  .state-caught { color: var(--color-brand-accent); }

  /* Default (and reduced-motion) state: show the outcome, no animation. */
  .state-dropped { opacity: 0; }
  .state-caught { opacity: 1; }

  @media (prefers-reduced-motion: no-preference) {
    .ledger.run .state-dropped {
      opacity: 1;
      animation: fade-out 0.45s ease forwards;
      animation-delay: calc(0.75s + var(--i) * 0.42s);
    }
    .ledger.run .state-caught {
      opacity: 0;
      animation: fade-in 0.45s ease forwards;
      animation-delay: calc(0.75s + var(--i) * 0.42s);
    }
    .ledger.run .row-label {
      animation: settle 0.45s ease backwards;
      animation-delay: calc(0.75s + var(--i) * 0.42s);
    }
  }
  @keyframes fade-out { to { opacity: 0; transform: translateY(-3px); } }
  @keyframes fade-in { from { transform: translateY(3px); } to { opacity: 1; transform: none; } }
  @keyframes settle { from { color: var(--color-brand-muted); } }

  .ledger-foot {
    margin: 0.95rem 0 0;
    font-size: 0.74rem;
    line-height: 1.5;
    color: var(--color-brand-muted);
  }

  @media (max-width: 980px) {
    .hero { padding: 7.5rem 1.25rem 3.5rem; }
    .hero-inner {
      grid-template-columns: minmax(0, 1fr);
      gap: 2.5rem;
    }
    .hero-sub { max-width: none; }
  }
  @media (max-width: 520px) {
    .row {
      grid-template-columns: auto minmax(0, 1fr);
      row-gap: 0.35rem;
    }
    .row-state { grid-column: 2; justify-items: start; }
  }
</style>

<script>
  const ledger = document.querySelector('.ledger');
  if (ledger) {
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => {
          if (e.isIntersecting) {
            ledger.classList.add('run');
            io.unobserve(e.target);
          }
        });
      },
      { threshold: 0.35 }
    );
    io.observe(ledger);
  }
</script>
