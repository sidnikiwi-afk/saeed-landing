---
const standards = [
  { label: 'UK numbers and UK hours', body: 'Local numbers, UK time, and language tuned for UK callers rather than translated from American English.' },
  { label: 'Your data stays yours', body: 'Recordings, transcripts and customer records are kept per business, with deletion on request and a retention period you set.' },
  { label: 'Access is locked down', body: 'Multi-factor sign-in, per-user accounts, and an audit trail of who looked at what.' },
  { label: 'Handover, not hostage', body: 'Numbers, records and prompts belong to you. If you leave, you take them, and we help you move them.' },
];
---
<section class="std">
  <div class="std-inner">
    <header class="std-head">
      <h2 class="std-title">Built to UK standards.</h2>
      <p class="std-sub">
        The unglamorous part, written down plainly, because this is what gets asked on the second
        call.
      </p>
    </header>

    <ul class="std-grid">
      {standards.map((s) => (
        <li class="std-item">
          <h3 class="std-label">{s.label}</h3>
          <p class="std-body">{s.body}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  @reference "../../styles/global.css";

  .std {
    background: var(--color-brand-surface);
    border-top: 1px solid var(--color-brand-line);
    padding: 4.5rem 1.5rem;
  }
  .std-inner {
    max-width: 1120px;
    margin: 0 auto;
  }
  .std-head {
    max-width: 620px;
    margin: 0 0 2.5rem;
  }
  .std-title {
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: clamp(1.6rem, 2.9vw, 2.1rem);
    line-height: 1.15;
    letter-spacing: -0.02em;
    color: var(--color-brand-ink);
    margin: 0 0 0.7rem;
  }
  .std-sub {
    font-size: 0.98rem;
    line-height: 1.6;
    color: var(--color-brand-muted);
    margin: 0;
  }

  .std-grid {
    list-style: none;
    margin: 0 0 3rem;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1.5rem;
  }
  .std-item {
    border-top: 1px solid var(--color-brand-line);
    padding-top: 1.1rem;
  }
  .std-label {
    font-family: var(--font-heading);
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--color-brand-ink);
    margin: 0 0 0.45rem;
    line-height: 1.35;
  }
  .std-body {
    font-size: 0.86rem;
    line-height: 1.56;
    color: var(--color-brand-muted);
    margin: 0;
  }

  @media (max-width: 900px) {
    .std-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 560px) {
    .std { padding: 3.5rem 1.25rem; }
    .std-grid { grid-template-columns: minmax(0, 1fr); gap: 1.25rem; }
  }
</style>
