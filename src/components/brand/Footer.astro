---
// ICO_REGISTRATION_NUMBER lives in src/data/ico.mjs so the footer and the privacy page share it.
import { ICO_REGISTER_URL, icoRegistrationNumber } from '../../data/ico.mjs';

const year = 2026;

const socials = [
  {
    label: 'LinkedIn',
    href: 'https://www.linkedin.com/in/muhammed-ahmed-9805a9354',
    path: 'M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.45v6.29zM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13zM7.12 20.45H3.56V9h3.56v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0z',
  },
  {
    label: 'X',
    href: 'https://x.com/saeedjx',
    path: 'M18.24 2.25h3.31l-7.23 8.26 8.5 11.24h-6.66l-5.21-6.82-5.97 6.82H1.67l7.73-8.84L1.25 2.25h6.83l4.71 6.23 5.45-6.23zm-1.16 17.52h1.83L7.08 4.13H5.12l11.96 15.64z',
  },
  {
    label: 'TikTok',
    href: 'https://www.tiktok.com/@brackstonedigital',
    path: 'M12.53.02C13.84 0 15.14.01 16.44 0c.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03-2.02-1.19-3.44-3.37-3.65-5.71-.02-.5-.03-1-.01-1.49.18-1.9 1.12-3.72 2.58-4.96 1.66-1.44 3.98-2.13 6.15-1.72.02 1.48-.04 2.96-.04 4.44-.99-.32-2.15-.23-3.02.37-.63.41-1.11 1.04-1.36 1.75-.21.51-.15 1.07-.14 1.61.24 1.64 1.82 3.02 3.5 2.87 1.12-.01 2.19-.66 2.77-1.61.19-.33.4-.67.41-1.06.1-1.79.06-3.57.07-5.36.01-4.03-.01-8.05.02-12.07z',
  },
];
---

<footer class="footer">
  <div class="inner">
    <p class="name">Brackstone Digital</p>
    <nav class="links" aria-label="Footer">
      <a href="/contact">Book a teardown</a>
      <a href="/privacy">Privacy</a>
    </nav>
    <ul class="socials" aria-label="Brackstone Digital on social media">
      {socials.map((social) => (
        <li>
          <a
            href={social.href}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={`${social.label} (opens in a new tab)`}
          >
            <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false">
              <path d={social.path} fill="currentColor" />
            </svg>
          </a>
        </li>
      ))}
    </ul>
  </div>
  <p class="ico">
    <span class="ico-badge">Registered with the ICO</span>
    {icoRegistrationNumber && <span>Registration number {icoRegistrationNumber}</span>}
    <a href={ICO_REGISTER_URL} target="_blank" rel="noopener noreferrer">Check the ICO register</a>
  </p>
  <p class="legal">
    &copy; {year} Brackstone Digital Limited. Registered in England and Wales, company no. 17159711.
    Registered office: 71-75 Shelton Street, Covent Garden, London, WC2H 9JQ.
  </p>
</footer>

<style>
  .footer {
    margin-top: auto;
    padding: 2.5rem 1.25rem 2rem;
    border-top: 1px solid var(--brand-line);
    color: var(--brand-muted);
    font-size: 0.8125rem;
    min-width: 0;
  }

  .inner {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 1rem 2rem;
    width: min(1140px, 100%);
    margin: 0 auto 1rem;
  }

  .name {
    margin: 0;
    color: var(--brand-ink);
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
  }

  .links a {
    color: var(--brand-muted);
    text-decoration: none;
  }

  .links a:hover {
    color: var(--brand-ink);
  }

  .socials {
    display: flex;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .socials a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    border: 1px solid var(--brand-line);
    border-radius: 999px;
    color: var(--brand-muted);
  }

  .socials a:hover {
    color: var(--brand-ink);
    border-color: var(--brand-ink);
  }

  .links a:focus-visible,
  .socials a:focus-visible,
  .ico a:focus-visible {
    outline: 2px solid var(--brand-purple);
    outline-offset: 2px;
  }

  .ico {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1rem;
    width: min(1140px, 100%);
    margin: 0 auto 1rem;
  }

  .ico-badge {
    padding: 0.25rem 0.625rem;
    border: 1px solid var(--brand-line);
    border-radius: 999px;
    color: var(--brand-ink);
    font-weight: 500;
  }

  .ico a {
    color: var(--brand-muted);
    text-underline-offset: 2px;
  }

  .ico a:hover {
    color: var(--brand-ink);
  }

  .legal {
    width: min(1140px, 100%);
    margin: 0 auto;
  }

  @media (max-width: 720px) {
    .inner,
    .links {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
