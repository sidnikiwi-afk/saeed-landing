---
const groups = [
  'Job management',
  'Phone and SMS',
  'Email inboxes',
  'Payments',
  'Tills and online ordering',
  'Property portals',
  'UK vehicle data',
  'Website forms',
];

const nodes = [
  'Phone',
  'Email',
  'Forms',
  'Jobs',
  'Diary',
  'Payments',
  'Tills',
  'Portals',
  'Vehicles',
  'Dashboard',
  'An API',
];

const placed = nodes.map((label, index) => {
  const angle = (index / nodes.length) * Math.PI * 2 - Math.PI / 2;
  return {
    label,
    x: (50 + Math.cos(angle) * 34).toFixed(2),
    y: (50 + Math.sin(angle) * 34).toFixed(2),
    api: index === nodes.length - 1,
  };
});
---

<section id="tools" aria-labelledby="tools-title">
  <div class="wrap">
    <div class="copy">
      <p class="eyebrow">Works with your tools</p>
      <h2 id="tools-title">Keep the software you run on. We make it talk to itself.</h2>
      <p class="lead">
        You should not have to switch systems to stop dropping work. We connect what you already use, and build the missing pieces around it.
      </p>
      <ul class="named">
        {groups.map((group) => <li>{group}</li>)}
      </ul>
      <p class="note">
        Built with tools including ServiceM8, Stripe, Twilio, Square and DVLA vehicle data. If it has an API, we can usually connect it.
      </p>
    </div>
    <div class="hub" aria-hidden="true">
      <svg viewBox="0 0 100 100" preserveAspectRatio="none">
        {
          placed.map((node) => (
            <line x1="50" y1="50" x2={node.x} y2={node.y} />
          ))
        }
        {
          placed.map((node, index) => {
            const fromHub = index % 2 === 0;
            const path = fromHub ? `M50,50 L${node.x},${node.y}` : `M${node.x},${node.y} L50,50`;
            const duration = (2.4 + (index % 4) * 0.5).toFixed(1);
            return (
              <circle
                class="dot"
                r="0.9"
                fill={index % 3 ? '#6e48f0' : '#00c896'}
                style={`offset-path: path('${path}'); animation-duration: ${duration}s; animation-delay: ${(index * 0.3).toFixed(1)}s`}
              />
            );
          })
        }
      </svg>
      <p class="core">Brackstone<small>your systems, connected</small></p>
      {
        placed.map((node) => (
          <p class:list={['node', node.api && 'api']} style={`left: ${node.x}%; top: ${node.y}%`}>
            {node.label}
          </p>
        ))
      }
    </div>
  </div>
</section>

<style>
  section {
    padding: 6.5rem 0;
    border-block: 1px solid var(--brand-line);
    background: #fff;
    overflow: hidden;
  }

  .wrap {
    display: grid;
    grid-template-columns: 1fr 1.05fr;
    gap: 3rem;
    align-items: center;
    width: min(1200px, calc(100% - 3rem));
    margin: 0 auto;
  }

  .eyebrow {
    margin: 0;
    color: var(--brand-purple);
    font-family: "Geist Mono", ui-monospace, monospace;
    font-size: 0.78rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  h2 {
    max-width: 12em;
    margin: 0.75rem 0 1rem;
    font-size: clamp(2rem, 4.2vw, 3.25rem);
    font-weight: 700;
    letter-spacing: -0.04em;
    line-height: 1.05;
    text-wrap: balance;
  }

  .lead,
  .note {
    max-width: 38rem;
    margin: 0;
    color: var(--brand-muted);
    font-size: 1.125rem;
  }

  .note {
    margin-top: 0.9rem;
    font-size: 0.85rem;
  }

  .named {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 1.4rem 0 0;
    padding: 0;
    list-style: none;
  }

  .named li {
    padding: 0.45rem 0.75rem;
    border: 1px solid var(--brand-line);
    border-radius: 10px;
    background: var(--brand-bg);
    font-size: 0.85rem;
    font-weight: 500;
  }

  .hub {
    position: relative;
    aspect-ratio: 1;
    width: min(100%, 34rem);
    margin: 0 auto;
  }

  svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  line {
    stroke: #e1dcf7;
    stroke-width: 0.35;
  }

  .dot {
    opacity: 0;
  }

  .core {
    position: absolute;
    top: 50%;
    left: 50%;
    display: grid;
    place-items: center;
    width: 7.5rem;
    height: 7.5rem;
    margin: 0;
    border-radius: 32px;
    background: linear-gradient(135deg, var(--brand-purple), #8b6cff);
    color: #fff;
    font-size: 0.95rem;
    font-weight: 700;
    text-align: center;
    transform: translate(-50%, -50%);
    box-shadow: 0 30px 60px -20px rgba(110, 72, 240, 0.7);
  }

  .core::before {
    content: "";
    position: absolute;
    inset: -0.85rem;
    border: 1px solid rgba(110, 72, 240, 0.25);
    border-radius: 40px;
  }

  .core small {
    display: block;
    max-width: 7rem;
    font-size: 0.68rem;
    font-weight: 500;
    line-height: 1.3;
    opacity: 0.85;
  }

  .node {
    position: absolute;
    margin: 0;
    padding: 0.45rem 0.65rem;
    border: 1px solid var(--brand-line);
    border-radius: 12px;
    background: #fff;
    font-size: 0.78rem;
    font-weight: 600;
    white-space: nowrap;
    transform: translate(-50%, -50%);
    box-shadow: 0 1px 2px rgba(10, 10, 20, 0.04), 0 8px 30px -8px rgba(40, 20, 120, 0.14);
  }

  .node::before {
    content: "";
    display: inline-block;
    width: 0.45rem;
    height: 0.45rem;
    margin-right: 0.4rem;
    border-radius: 50%;
    background: var(--brand-purple);
  }

  .api {
    border-style: dashed;
    border-color: #cfc6f7;
    color: #4a28d6;
  }

  @media (max-width: 960px) {
    .wrap {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 700px) {
    .hub {
      display: none;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .dot {
      offset-distance: 0%;
      opacity: 1;
      animation-name: spoke;
      animation-timing-function: linear;
      animation-iteration-count: infinite;
    }

    .core::before {
      animation: core-pulse 2.6s ease-out infinite;
    }

    .node {
      animation: node-hot 15.4s linear infinite;
    }

    .node:nth-child(3) { animation-delay: 0s; }
    .node:nth-child(4) { animation-delay: -1.4s; }
    .node:nth-child(5) { animation-delay: -2.8s; }
    .node:nth-child(6) { animation-delay: -4.2s; }
    .node:nth-child(7) { animation-delay: -5.6s; }
    .node:nth-child(8) { animation-delay: -7s; }
    .node:nth-child(9) { animation-delay: -8.4s; }
    .node:nth-child(10) { animation-delay: -9.8s; }
    .node:nth-child(11) { animation-delay: -11.2s; }
    .node:nth-child(12) { animation-delay: -12.6s; }
    .node:nth-child(13) { animation-delay: -14s; }
  }

  @keyframes spoke {
    to { offset-distance: 100%; }
  }

  @keyframes core-pulse {
    from { transform: scale(0.95); opacity: 1; }
    to { transform: scale(1.25); opacity: 0; }
  }

  @keyframes node-hot {
    0%, 7% {
      border-color: var(--brand-purple);
      box-shadow: 0 0 0 4px rgba(110, 72, 240, 0.12), 0 8px 30px -8px rgba(40, 20, 120, 0.14);
    }
    10%, 100% {
      border-color: var(--brand-line);
      box-shadow: 0 1px 2px rgba(10, 10, 20, 0.04), 0 8px 30px -8px rgba(40, 20, 120, 0.14);
    }
  }
</style>
