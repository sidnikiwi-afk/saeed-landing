---
import IllustrativeCaption from './IllustrativeCaption.astro';

const pieces = [
  {
    sector: 'Garages',
    status: 'Live',
    tone: 'live',
    title: 'An AI receptionist that books MOTs and services',
    body: 'Answers every call, looks up the vehicle from the reg, checks the MOT date and books the slot.',
    kit: ['Voice AI', 'Vehicle data', 'SMS'],
  },
  {
    sector: 'Car sales',
    status: 'Live demo',
    tone: 'live',
    title: 'A dealer website with an AI line that knows the stock',
    body: 'Callers ask about cars in stock, finance and test drives, and the team gets a clean summary.',
    kit: ['Website', 'Voice AI', 'Dashboard'],
  },
  {
    sector: 'Estate agency',
    status: 'Built',
    tone: 'live',
    title: 'Portal enquiries turned into booked viewings',
    body: 'Enquiry emails from property portals are read, matched to the property and turned into a viewing.',
    kit: ['Email', 'Workflow', 'Diary'],
  },
  {
    sector: 'Manufacturing',
    status: 'Built',
    tone: 'live',
    title: 'Reporting straight from a job-management system',
    body: 'Pulls jobs, stages and customers through the API so the owner can see what is stuck and where.',
    kit: ['API integration', 'Reporting'],
  },
  {
    sector: 'Electrical',
    status: 'Pilot',
    tone: 'pilot',
    title: 'A quoting helper that works from drawings',
    body: 'Reads drawings and site notes and drafts the first pass of a quote for the estimator to check.',
    kit: ['Documents', 'Quoting'],
  },
  {
    sector: 'Many sectors',
    status: 'Live',
    tone: 'live',
    title: 'A multi-business dashboard with billing built in',
    body: 'Calls, transcripts, follow-ups and payments for each business, kept separate and secure.',
    kit: ['Dashboard', 'Payments', 'Security'],
  },
];
---

<section id="built" aria-labelledby="built-title">
  <div class="wrap">
    <p class="eyebrow">Things we have built</p>
    <h2 id="built-title">Real systems for real small businesses.</h2>
    <p class="lead">A few examples of the kind of work we do. We keep client names private.</p>
    <IllustrativeCaption>These describe the kind of system, with no client names.</IllustrativeCaption>
    <div class="grid">
      {
        pieces.map((piece) => (
          <article class="card">
            <p class="top">
              <span class="sector">{piece.sector}</span>
              <span class:list={['status', piece.tone]}>{piece.status}</span>
            </p>
            <h3>{piece.title}</h3>
            <p>{piece.body}</p>
            <ul>
              {piece.kit.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  section {
    padding: 6.5rem 0;
  }

  .wrap {
    width: min(1200px, calc(100% - 3rem));
    margin: 0 auto;
  }

  .eyebrow {
    margin: 0;
    color: var(--brand-purple);
    font-family: "Geist Mono", ui-monospace, monospace;
    font-size: 0.78rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  h2 {
    max-width: 14em;
    margin: 0.75rem 0 1rem;
    font-size: clamp(2rem, 4.2vw, 3.25rem);
    font-weight: 700;
    letter-spacing: -0.04em;
    line-height: 1.05;
    text-wrap: balance;
  }

  .lead {
    max-width: 38rem;
    margin: 0 0 1rem;
    color: var(--brand-muted);
    font-size: 1.125rem;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
    margin-top: 2.5rem;
  }

  .card {
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
    min-width: 0;
    padding: 1.5rem;
    border: 1px solid var(--brand-line);
    border-radius: 20px;
    background: #fff;
    box-shadow: 0 1px 2px rgba(10, 10, 20, 0.04), 0 8px 30px -8px rgba(40, 20, 120, 0.14);
  }

  .card:hover {
    transform: translateY(-4px);
  }

  .top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    margin: 0;
  }

  .sector {
    color: var(--brand-muted);
    font-family: "Geist Mono", ui-monospace, monospace;
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .status {
    padding: 0.15rem 0.55rem;
    border-radius: 99px;
    font-size: 0.7rem;
    font-weight: 700;
  }

  .live {
    background: #e6faf3;
    color: #047857;
  }

  .pilot {
    background: #fff4e5;
    color: #b45309;
  }

  h3 {
    margin: 0;
    font-size: 1.15rem;
    font-weight: 650;
    letter-spacing: -0.02em;
    line-height: 1.3;
    text-wrap: balance;
  }

  .card > p {
    margin: 0;
    color: var(--brand-muted);
    font-size: 0.92rem;
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin: auto 0 0;
    padding: 0.5rem 0 0;
    list-style: none;
  }

  li {
    padding: 0.25rem 0.55rem;
    border-radius: 99px;
    background: #f3f3f6;
    font-size: 0.72rem;
  }

  @media (max-width: 960px) {
    .grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 640px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .card,
    .card:hover {
      transform: none;
    }
  }
</style>
