---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/home/Nav.astro';
import Footer from '../components/home/Footer.astro';

// Where the contact form posts. Enquiries must reach saeed@brackstonedigital.co.uk.
// Change this one value to switch delivery. The form reads the response status, so
// whatever sits behind it must return a 2xx on success.
const FORM_ENDPOINT = 'https://primary-production-64370.up.railway.app/webhook/brackstone-lead';

const reassurances = [
  'One working day for a reply, usually sooner',
  'A look at your actual enquiry flow, not a slide deck',
  'If we cannot help, we will say so on the call',
];
---

<Layout
  title="Book a teardown - Brackstone"
  description="Tell us what your team keeps dropping. We map where your enquiries leak, show you what we would automate first, and say plainly if we are not the right fit."
>
  <style is:global>
    html { scroll-behavior: smooth; }
    body {
      background: var(--color-brand-bg) !important;
      color: var(--color-brand-text) !important;
      font-family: var(--font-body) !important;
      overflow-x: hidden;
      -webkit-font-smoothing: antialiased;
      -moz-osx-font-smoothing: grayscale;
    }
    h1, h2, h3, h4, h5, h6 { font-family: var(--font-heading) !important; }
    ::selection { background: var(--color-brand-primary); color: #fff; }
  </style>

  <Nav base="/" />

  <main class="contact">
    <div class="contact-bg" aria-hidden="true"></div>
    <div class="contact-inner">
      <div class="contact-copy">
        <span class="eyebrow">Book a teardown</span>
        <h1 class="headline">
          Tell us what your team
          <span class="grad">keeps dropping.</span>
        </h1>
        <p class="lede">
          Fifteen minutes. We map where your enquiries leak, show you what we would automate
          first, and say plainly if we are not the right fit.
        </p>
        <ul class="reassure">
          {reassurances.map((r) => (
            <li>
              <span class="tick" aria-hidden="true">
                <svg viewBox="0 0 16 16" width="11" height="11" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round"><path d="M3 8.5l3 3 7-7"/></svg>
              </span>
              <span>{r}</span>
            </li>
          ))}
        </ul>
      </div>

      <div class="form-card">
        <form class="form" id="contact-form" novalidate>
          <div class="field">
            <label for="name">Your name</label>
            <input type="text" id="name" name="name" required autocomplete="name" placeholder="e.g. Sarah Johnson" />
          </div>
          <div class="field">
            <label for="email">Work email</label>
            <input type="email" id="email" name="email" required autocomplete="email" placeholder="sarah@company.co.uk" />
          </div>
          <div class="field">
            <label for="business">What kind of business is it?</label>
            <input type="text" id="business" name="business" autocomplete="organization" placeholder="e.g. garage, letting agent, clinic" />
          </div>
          <div class="field">
            <label for="message">What keeps slipping?</label>
            <textarea id="message" name="message" rows="4" placeholder="Missed calls, quotes nobody chased, empty slots in the diary..."></textarea>
          </div>

          <button type="submit" class="submit" id="submit-btn">
            <span id="submit-label">Book the teardown</span>
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
              <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>

          <p class="privacy">
            We use these details only to reply to you. Nothing else, no list.
            See our <a href="/privacy">privacy policy</a>.
          </p>

          <p class="error" id="form-error" role="alert" hidden>
            That did not send. Please try again in a moment.
          </p>
        </form>

        <div class="success" id="form-success" hidden>
          <span class="success-mark" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round"><path d="M5 13l4 4L19 7"/></svg>
          </span>
          <h2 class="success-title">Got it, thank you.</h2>
          <p class="success-body">
            We will come back to you within one working day with a time and what we would want to
            look at first.
          </p>
        </div>
      </div>
    </div>
  </main>

  <Footer base="/" />
</Layout>

<style>
  @reference "../styles/global.css";

  .contact {
    position: relative;
    padding: 9rem 1.5rem 5rem;
    overflow: hidden;
    background: var(--color-brand-bg);
  }
  .contact-bg {
    position: absolute;
    inset: -10% -5% 40% -5%;
    background:
      radial-gradient(55% 60% at 20% 0%, rgba(110, 72, 240, 0.15), transparent 70%),
      radial-gradient(40% 50% at 90% 10%, rgba(0, 200, 150, 0.08), transparent 70%);
    pointer-events: none;
  }
  .contact-inner {
    position: relative;
    z-index: 2;
    max-width: 1080px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 4rem;
    align-items: start;
  }

  .eyebrow {
    display: inline-block;
    font-size: 0.76rem;
    font-weight: 600;
    color: var(--color-brand-primary);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin-bottom: 0.9rem;
  }
  .headline {
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: clamp(2rem, 4vw, 3rem);
    line-height: 1.08;
    letter-spacing: -0.02em;
    color: var(--color-brand-ink);
    margin: 0 0 1.1rem;
    text-wrap: balance;
  }
  .grad {
    display: block;
    background: linear-gradient(100deg, var(--color-brand-primary), var(--color-brand-accent));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .lede {
    font-size: 1.04rem;
    line-height: 1.62;
    color: var(--color-brand-muted);
    margin: 0 0 2rem;
    max-width: 30rem;
  }
  .reassure {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.7rem;
  }
  .reassure li {
    display: flex;
    align-items: flex-start;
    gap: 0.6rem;
    font-size: 0.9rem;
    line-height: 1.5;
    color: var(--color-brand-muted);
  }
  .tick {
    flex: none;
    margin-top: 0.15rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 16px;
    height: 16px;
    border-radius: 50%;
    background: color-mix(in srgb, var(--color-brand-accent) 16%, transparent);
    color: var(--color-brand-accent);
  }

  .form-card {
    background: var(--color-brand-surface);
    border: 1px solid var(--color-brand-line);
    border-radius: 14px;
    padding: 1.9rem;
    box-shadow: 0 24px 60px -34px rgba(10, 10, 11, 0.35);
  }
  .form {
    display: grid;
    gap: 1.15rem;
  }
  .field {
    display: grid;
    gap: 0.42rem;
  }
  .field label {
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--color-brand-ink);
  }
  .field input,
  .field textarea {
    width: 100%;
    background: var(--color-brand-bg);
    border: 1px solid var(--color-brand-line);
    border-radius: 9px;
    padding: 0.75rem 0.9rem;
    font-family: var(--font-body);
    font-size: 0.94rem;
    color: var(--color-brand-ink);
    transition: border-color 0.18s ease, box-shadow 0.18s ease;
    outline: none;
  }
  .field textarea { resize: vertical; min-height: 104px; }
  .field input::placeholder,
  .field textarea::placeholder { color: color-mix(in srgb, var(--color-brand-muted) 60%, transparent); }
  .field input:focus,
  .field textarea:focus {
    border-color: var(--color-brand-primary);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--color-brand-primary) 14%, transparent);
  }
  .field input[aria-invalid='true'],
  .field textarea[aria-invalid='true'] {
    border-color: color-mix(in srgb, var(--color-brand-primary) 55%, #c0392b);
  }

  /* Same shape and weight as the primary buttons on the homepage. */
  .submit {
    justify-self: start;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.85rem 1.4rem;
    border: none;
    border-radius: 9px;
    background: var(--color-brand-primary);
    color: #fff;
    font-family: var(--font-body);
    font-size: 0.95rem;
    font-weight: 500;
    cursor: pointer;
    transition: background 0.18s ease, transform 0.18s ease;
  }
  .submit:hover:not(:disabled) {
    background: var(--color-brand-primary-2);
    transform: translateY(-1px);
  }
  .submit:focus-visible {
    outline: 2px solid var(--color-brand-primary);
    outline-offset: 3px;
  }
  .submit:disabled { opacity: 0.65; cursor: not-allowed; transform: none; }

  .privacy {
    font-size: 0.78rem;
    line-height: 1.55;
    color: var(--color-brand-muted);
    margin: 0;
  }
  .privacy a { color: var(--color-brand-muted); text-decoration: underline; }
  .privacy a:hover { color: var(--color-brand-ink); }

  .error {
    margin: 0;
    padding: 0.7rem 0.85rem;
    border-radius: 9px;
    border: 1px solid color-mix(in srgb, #c0392b 30%, var(--color-brand-line));
    background: color-mix(in srgb, #c0392b 6%, transparent);
    font-size: 0.85rem;
    color: var(--color-brand-ink);
  }
  .error[hidden] { display: none; }

  .success { text-align: left; }
  .success[hidden] { display: none; }
  .success-mark {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: color-mix(in srgb, var(--color-brand-accent) 15%, transparent);
    color: var(--color-brand-accent);
    margin-bottom: 1rem;
  }
  .success-title {
    font-family: var(--font-heading);
    font-size: 1.2rem;
    font-weight: 600;
    color: var(--color-brand-ink);
    margin: 0 0 0.5rem;
  }
  .success-body {
    font-size: 0.94rem;
    line-height: 1.6;
    color: var(--color-brand-muted);
    margin: 0;
  }

  @media (max-width: 900px) {
    .contact { padding: 7.5rem 1.25rem 3.5rem; }
    .contact-inner { grid-template-columns: minmax(0, 1fr); gap: 2.5rem; }
    .lede { max-width: none; }
    .form-card { padding: 1.5rem 1.25rem; }
  }
</style>

<script define:vars={{ FORM_ENDPOINT }}>
  const form = document.getElementById('contact-form');
  const btn = document.getElementById('submit-btn');
  const label = document.getElementById('submit-label');
  const errorBox = document.getElementById('form-error');
  const success = document.getElementById('form-success');

  const setInvalid = (el, invalid) => {
    if (invalid) el.setAttribute('aria-invalid', 'true');
    else el.removeAttribute('aria-invalid');
  };

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    errorBox.hidden = true;

    const name = form.querySelector('#name');
    const email = form.querySelector('#email');

    const missingName = !name.value.trim();
    const badEmail = !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email.value.trim());
    setInvalid(name, missingName);
    setInvalid(email, badEmail);

    if (missingName || badEmail) {
      (missingName ? name : email).focus();
      return;
    }

    btn.disabled = true;
    label.textContent = 'Sending...';

    try {
      const res = await fetch(FORM_ENDPOINT, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          name: name.value.trim(),
          email: email.value.trim(),
          business: form.querySelector('#business').value.trim(),
          message: form.querySelector('#message').value.trim(),
          source: 'brackstonedigital.co.uk/contact',
          submitted_at: new Date().toISOString(),
        }),
      });

      // Only claim it sent if it actually did.
      if (!res.ok) throw new Error(`Endpoint returned ${res.status}`);

      form.hidden = true;
      success.hidden = false;
      success.scrollIntoView({ block: 'nearest', behavior: 'smooth' });
    } catch (err) {
      errorBox.hidden = false;
      btn.disabled = false;
      label.textContent = 'Book the teardown';
    }
  });
</script>
