---
import AdsLayout from '../layouts/AdsLayout.astro';
import { adsSettings } from '../data/ads/settings.mjs';
import { planFor } from '../lib/ads-page.mjs';
import { SIGNUP_INDUSTRY_GROUPS } from '../lib/get-started.mjs';

const TURNSTILE_SITE_KEY = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY || '';
const conversion = adsSettings.googleAdsConversion;
const trial = adsSettings.trial;
// Both plans are in the page. The script shows the one that matches the chosen
// industry; without JavaScript the general plan shows with a garage note.
const plans = [
  { key: 'receptionist', plan: planFor(adsSettings, 'receptionist') },
  { key: 'garage', plan: planFor(adsSettings, 'garage') },
];
// The form only sends through the script, which adds the security check
// token. Without the script the button stays disabled and the visitor sees
// an email route instead of posting to the endpoint and landing on JSON.
const NO_SCRIPT_EMAIL = 'saeed@brackstonedigital.co.uk';
const noScriptHref = `mailto:${NO_SCRIPT_EMAIL}?subject=${encodeURIComponent('7-day free trial request')}`;
---

<AdsLayout
  title="Start your 7-day free trial | Brackstone"
  description={`${trial.line.receptionist} ${trial.promise}`}
  noindex={true}
>
  <header class="hd">
    <div class="wrap bar">
      <a class="logo" href="/">
        <span class="mark" aria-hidden="true">B</span>
        Brackstone
      </a>
    </div>
  </header>

  <main class="signup">
    <div class="wrap">
      <h1>Start your <span class="accent"><span class="keep">7-day</span> free trial</span></h1>
      {plans.map(({ key, plan }) => (
        <div class="plan" data-plan={key} hidden={key !== 'receptionist'}>
          <p class="trial-line">{trial.line[key]}</p>
        </div>
      ))}
      <p class="next">{trial.promise}</p>
      {plans.map(({ key, plan }) => (
        <div class="plan after" data-plan={key} hidden={key !== 'receptionist'}>
          <p class="plan-name">{plan.name}</p>
          <p class="price">{plan.amount}</p>
          <p class="minutes">{plan.minutes}</p>
          <p class="setup">{plan.setup}</p>
          <p class="extra">{plan.extraMinutes}</p>
        </div>
      ))}
      <p class="extra" id="garage-note">Garage edition {adsSettings.plans.garage.amount}</p>

      <form
        class="form"
        id="signup-form"
        data-turnstile-key={TURNSTILE_SITE_KEY}
        data-conversion-id={conversion.id}
        data-conversion-label={conversion.label}
      >
        <div class="field">
          <label for="business">Business name</label>
          <input type="text" id="business" aria-describedby="business-error" name="business_name" required autocomplete="organization" />
          <p class="field-error" id="business-error" hidden>Enter your business name.</p>
        </div>
        <div class="field">
          <label for="email">Email</label>
          <input type="email" id="email" aria-describedby="email-error" name="email" required autocomplete="email" />
          <p class="field-error" id="email-error" hidden>Enter your email address.</p>
        </div>
        <div class="field">
          <label for="phone">Phone</label>
          <input type="tel" id="phone" aria-describedby="phone-error" name="phone" required autocomplete="tel" />
          <p class="field-error" id="phone-error" hidden>Enter your phone number.</p>
        </div>
        <div class="field">
          <label for="chosen-industry">Industry</label>
          <select id="chosen-industry" aria-describedby="chosen-industry-error" name="industry" required>
            <option value="" selected disabled>Choose one</option>
            {SIGNUP_INDUSTRY_GROUPS.map(({ group, options }) => (
              <optgroup label={group}>
                {options.map((option) => <option value={option}>{option}</option>)}
              </optgroup>
            ))}
          </select>
          <p class="field-error" id="chosen-industry-error" hidden>Choose an industry.</p>
        </div>
        <div class="field" id="other-industry-field">
          <label for="other-industry">What kind of business?</label>
          <input type="text" id="other-industry" aria-describedby="other-industry-error" name="other_industry" autocomplete="off" />
          <p class="field-error" id="other-industry-error" hidden>Tell us what kind of business you run.</p>
        </div>
        <div class="field">
          <label for="website">Website <span class="optional">(optional)</span></label>
          <input type="text" id="website" name="website" inputmode="url" autocomplete="url" />
        </div>
        <div class="field">
          <label for="missed">What happens to calls you miss today? <span class="optional">(optional)</span></label>
          <textarea id="missed" name="notes" rows="3"></textarea>
        </div>

        <div class="hp" aria-hidden="true">
          <label for="company-fax">Leave this empty</label>
          <input type="text" id="company-fax" name="company_fax" tabindex="-1" autocomplete="off" />
        </div>

        <input type="hidden" name="gclid" value="" />
        <input type="hidden" name="utm_source" value="" />
        <input type="hidden" name="utm_medium" value="" />
        <input type="hidden" name="utm_campaign" value="" />
        <input type="hidden" name="utm_term" value="" />
        <input type="hidden" name="utm_content" value="" />
        <input type="hidden" name="landing_page" value="/get-started/" />

        {TURNSTILE_SITE_KEY && (
          <div class="turnstile">
            <div
              class="cf-turnstile"
              data-sitekey={TURNSTILE_SITE_KEY}
              data-theme="light"
              data-action="brackstone-contact"
              data-appearance="interaction-only"
            ></div>
          </div>
        )}

        <p class="noscript" id="noscript-note">
          This form needs JavaScript. If the button stays greyed out, email
          <a href={noScriptHref}>{NO_SCRIPT_EMAIL}</a> with your business name and phone number,
          and we'll start your trial from there.
        </p>

        <button type="submit" class="submit" id="submit-btn" disabled>
          <span id="submit-label">{trial.button}</span>
        </button>

        <p class="privacy">
          {trial.consent}
          See our <a href="/privacy">privacy policy</a>.
        </p>

        <p class="error" id="form-error" role="alert" hidden>
          That did not send. Please check your connection and try again.
        </p>
      </form>

      <div class="success" id="form-success" hidden>
        <span class="success-mark" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12.5l4.5 4.5L19 7.5"></path></svg>
        </span>
        <h2 id="success-heading" tabindex="-1">We've received your trial request. {trial.promise}</h2>
      </div>
    </div>
  </main>

  <footer class="foot">
    <div class="wrap">
      <p>&copy; 2026 Brackstone Digital Limited. Registered in England and Wales, company no. 17159711.</p>
      <p class="foot-links"><a href="/privacy">Privacy</a></p>
    </div>
  </footer>
</AdsLayout>

{TURNSTILE_SITE_KEY && (
  <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
)}

<script>
  import {
    OTHER_INDUSTRY,
    TRACKING_FIELDS,
    industryFromQuery,
    industryPlanKey,
    sendTrialRequest,
    signupErrors,
    trialRequestBody,
  } from '../lib/get-started.mjs';

  const form = document.getElementById('signup-form');
  const TURNSTILE_SITE_KEY = form?.dataset.turnstileKey || '';
  const conversion = {
    id: form?.dataset.conversionId || '',
    label: form?.dataset.conversionLabel || '',
  };
  const btn = document.getElementById('submit-btn');
  const label = document.getElementById('submit-label');
  const buttonText = label?.textContent || '';
  const errorBox = document.getElementById('form-error');
  const success = document.getElementById('form-success');
  const successHeading = document.getElementById('success-heading');
  const email = form?.querySelector('#email');
  const business = form?.querySelector('#business');
  const chosen = form?.querySelector('#chosen-industry');
  const phone = form?.querySelector('#phone');
  const otherField = document.getElementById('other-industry-field');
  const otherInput = form?.querySelector('#other-industry');

  // The script checks the fields itself and shows its own messages.
  if (form) form.noValidate = true;

  // The button ships disabled so the form cannot post without this script.
  if (btn) btn.disabled = false;
  const noScriptNote = document.getElementById('noscript-note');
  if (noScriptNote) noScriptNote.hidden = true;

  // Shows the plan for the chosen industry and the Other field when it applies.
  const showChoice = () => {
    const key = industryPlanKey(chosen?.value);
    for (const node of document.querySelectorAll('[data-plan]')) {
      node.hidden = node.getAttribute('data-plan') !== key;
    }
    const note = document.getElementById('garage-note');
    if (note) note.hidden = true;
    if (otherField) otherField.hidden = chosen?.value !== OTHER_INDUSTRY;
  };

  const queryFields = TRACKING_FIELDS.filter((name) => name !== 'landing_page');

  const fillHidden = () => {
    if (!form) return;
    const params = new URLSearchParams(window.location.search);
    for (const name of queryFields) {
      const input = form.querySelector(`[name="${name}"]`);
      if (input) input.value = (params.get(name) || '').trim();
    }
    const landing = form.querySelector('[name="landing_page"]');
    if (landing) landing.value = window.location.pathname;
    const fromQuery = industryFromQuery(params.get('industry'));
    if (chosen && fromQuery && !chosen.value) chosen.value = fromQuery;
  };

  fillHidden();
  showChoice();
  chosen?.addEventListener('change', showChoice);

  const setInvalid = (el, invalid) => {
    if (!el) return;
    if (invalid) el.setAttribute('aria-invalid', 'true');
    else el.removeAttribute('aria-invalid');
    const message = document.getElementById(`${el.id}-error`);
    if (message) message.hidden = !invalid;
  };

  const showError = (message) => {
    errorBox.textContent = message;
    errorBox.hidden = false;
  };

  const turnstileToken = () => {
    const field = form?.querySelector('[name="cf-turnstile-response"]');
    if (field?.value) return field.value;
    try {
      return window.turnstile?.getResponse?.() || '';
    } catch (_err) {
      return '';
    }
  };

  const resetTurnstile = () => {
    try { window.turnstile?.reset?.(); } catch (_err) { /* widget not loaded */ }
  };

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    errorBox.hidden = true;
    fillHidden();

    const honeypot = form.querySelector('#company-fax');
    if (honeypot?.value.trim()) {
      form.hidden = true;
      success.hidden = false;
      return;
    }

    const isOther = chosen.value === OTHER_INDUSTRY;
    const errors = signupErrors({
      email: email.value,
      business: business.value,
      industry: chosen.value,
      phone: phone.value,
      otherIndustry: otherInput?.value,
    });
    const fields = { business, email, phone, industry: chosen, other: otherInput };
    for (const [key, el] of Object.entries(fields)) setInvalid(el, errors.includes(key));

    if (errors.length > 0) {
      fields[errors[0]].focus();
      return;
    }

    const token = turnstileToken();
    if (TURNSTILE_SITE_KEY && !token) {
      showError('Please complete the security check.');
      return;
    }

    btn.disabled = true;
    label.textContent = 'Sending...';

    const hidden = {};
    for (const name of TRACKING_FIELDS) {
      hidden[name] = form.querySelector(`[name="${name}"]`)?.value || '';
    }

    const result = await sendTrialRequest({
      fetchImpl: window.fetch.bind(window),
      body: trialRequestBody({
        businessName: business.value,
        email: email.value,
        phone: phone.value,
        industry: chosen.value,
        otherIndustry: isOther ? otherInput?.value : '',
        website: form.querySelector('#website').value,
        notes: form.querySelector('#missed').value,
        hidden,
        turnstileToken: token,
      }),
      view: window,
      settings: { googleAdsConversion: conversion },
      cookieString: document.cookie,
    });

    if (result.accepted) {
      if (result.message && successHeading) successHeading.textContent = result.message;
      form.hidden = true;
      success.hidden = false;
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      success.scrollIntoView({ block: 'nearest', behavior: reduce ? 'auto' : 'smooth' });
      successHeading?.focus({ preventScroll: true });
      return;
    }

    // A token is good for one check, so a refusal needs a fresh one.
    resetTurnstile();
    showError(result.message);
    btn.disabled = false;
    label.textContent = buttonText;
  });
</script>

<style>
  /* Keeps a focused field clear of the sticky header. */
  :global(html) {
    scroll-padding-top: 5rem;
  }

  /* Header, footer, headline, buttons and cards follow the ads page
     (src/components/ads/AdsPage.astro) so sign-up reads as the same site. */
  .hd {
    position: sticky;
    top: 0;
    z-index: 40;
    background: rgba(250, 250, 251, 0.92);
    border-bottom: 1px solid var(--brand-line);
    backdrop-filter: blur(12px);
  }

  .bar {
    display: flex;
    align-items: center;
    min-height: 4rem;
    padding-top: 0.5rem;
    padding-bottom: 0.5rem;
  }

  .hd .wrap,
  .foot .wrap {
    width: min(1120px, 100%);
  }

  .signup {
    position: relative;
    flex: 1;
    overflow: hidden;
    padding: 3rem 0 4rem;
  }

  .signup::before {
    content: "";
    position: absolute;
    top: -12rem;
    left: 50%;
    width: min(900px, 140%);
    height: 32rem;
    transform: translateX(-50%);
    background:
      radial-gradient(closest-side, rgba(110, 72, 240, 0.16), transparent),
      radial-gradient(closest-side at 80% 70%, rgba(0, 200, 150, 0.1), transparent);
    pointer-events: none;
  }

  .wrap {
    position: relative;
    width: min(640px, 100%);
    margin: 0 auto;
    padding: 0 1.25rem;
  }

  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    color: var(--brand-ink);
    font-weight: 700;
    letter-spacing: -0.02em;
    text-decoration: none;
  }

  .mark {
    display: grid;
    width: 1.625rem;
    height: 1.625rem;
    place-items: center;
    border-radius: 8px;
    background: linear-gradient(135deg, var(--brand-purple), #8b6cff);
    color: #fff;
    font-size: 0.85rem;
    font-weight: 800;
  }

  h1 {
    margin: 0 0 0.85rem;
    font-size: clamp(2.25rem, 5.4vw, 3.25rem);
    font-weight: 800;
    letter-spacing: -0.045em;
    line-height: 1.03;
    text-wrap: balance;
  }

  h1 .accent {
    color: var(--brand-purple);
  }

  h1 .keep {
    white-space: nowrap;
  }

  @supports ((-webkit-background-clip: text) or (background-clip: text)) {
    h1 .accent {
      background: linear-gradient(100deg, var(--brand-purple), var(--brand-mint-text));
      -webkit-background-clip: text;
      background-clip: text;
      color: transparent;
    }
  }

  .trial-line {
    margin: 0 0 0.5rem;
    font-size: 1.08rem;
    font-weight: 700;
    line-height: 1.45;
  }

  .next,
  .setup {
    margin: 0 0 0.7rem;
    color: var(--brand-muted);
    font-size: 1.08rem;
    line-height: 1.5;
  }

  .price {
    margin: 1.4rem 0 0.35rem;
    font-size: clamp(1.5rem, 3vw, 1.9rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1.15;
  }

  .plan[hidden],
  .extra[hidden] {
    display: none;
  }

  .plan.after {
    margin-top: 1.4rem;
    padding-top: 1.1rem;
    border-top: 1px solid var(--brand-line);
  }

  .plan-name {
    margin: 0;
    font-size: 1.15rem;
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  .plan-name + .price {
    margin-top: 0.2rem;
  }

  .minutes {
    margin: 0 0 0.35rem;
    font-weight: 600;
  }

  .extra {
    margin: 0 0 0.35rem;
    color: var(--brand-muted);
    font-size: 0.85rem;
  }

  .form,
  .success {
    position: relative;
    margin-top: 1.75rem;
    padding: 1.5rem;
    border: 1px solid var(--brand-line);
    border-radius: 20px;
    background: #fff;
    box-shadow: 0 1px 2px rgba(10, 10, 20, 0.04), 0 8px 30px -8px rgba(40, 20, 120, 0.14);
  }

  .form {
    display: grid;
    gap: 1.1rem;
  }

  .form[hidden],
  .field[hidden],
  .error[hidden],
  .success[hidden],
  .noscript[hidden],
  .field-error[hidden] {
    display: none;
  }

  .field {
    display: grid;
    gap: 0.4rem;
  }

  .field label {
    font-size: 0.85rem;
    font-weight: 600;
  }

  .field input,
  .field select,
  .field textarea {
    width: 100%;
    padding: 0.75rem 0.9rem;
    border: 1px solid var(--brand-line);
    border-radius: 11px;
    background: var(--brand-bg);
    color: var(--brand-ink);
    font: inherit;
    font-size: 0.94rem;
    transition: border-color 0.15s ease;
  }

  .field textarea {
    resize: vertical;
    min-height: 6rem;
  }

  .field input:focus,
  .field select:focus,
  .field textarea:focus {
    border-color: var(--brand-purple);
    outline: 2px solid var(--brand-purple);
    outline-offset: 1px;
  }

  .field input[aria-invalid='true'],
  .field select[aria-invalid='true'],
  .field textarea[aria-invalid='true'] {
    border-color: #c0392b;
  }

  .field-error {
    margin: 0;
    color: #b42318;
    font-size: 0.82rem;
    font-weight: 600;
  }

  .hp {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .submit {
    justify-self: start;
    min-height: 3rem;
    padding: 0.8rem 1.4rem;
    border: 1px solid transparent;
    border-radius: 12px;
    background: var(--brand-purple);
    color: #fff;
    font: inherit;
    font-size: 0.95rem;
    font-weight: 600;
    line-height: 1.2;
    box-shadow: 0 8px 24px -8px rgba(110, 72, 240, 0.8);
    cursor: pointer;
    transition: background 0.15s ease, transform 0.15s ease;
  }

  .submit:hover:not(:disabled) {
    background: var(--brand-purple-deep);
  }

  .submit:active:not(:disabled) {
    transform: scale(0.98);
  }

  .submit:focus-visible,
  .logo:focus-visible,
  .privacy a:focus-visible,
  .noscript a:focus-visible,
  .foot a:focus-visible {
    outline: 2px solid var(--brand-purple);
    outline-offset: 3px;
  }

  .submit:disabled {
    opacity: 0.65;
    cursor: not-allowed;
  }

  .optional {
    color: var(--brand-muted);
    font-weight: 500;
  }

  .noscript {
    margin: 0;
    padding: 0.7rem 0.85rem;
    border: 1px solid var(--brand-line);
    border-radius: 11px;
    background: var(--brand-bg);
    font-size: 0.85rem;
    line-height: 1.5;
  }

  .noscript a {
    color: var(--brand-purple);
    font-weight: 600;
  }

  .privacy {
    margin: 0;
    color: var(--brand-muted);
    font-size: 0.82rem;
    line-height: 1.5;
  }

  .privacy a {
    color: inherit;
  }

  .error {
    margin: 0;
    padding: 0.7rem 0.85rem;
    border: 1px solid color-mix(in srgb, #c0392b 30%, var(--brand-line));
    border-radius: 11px;
    background: color-mix(in srgb, #c0392b 6%, transparent);
    color: var(--brand-ink);
    font-size: 0.85rem;
  }

  .success-mark {
    display: inline-flex;
    width: 2.5rem;
    height: 2.5rem;
    align-items: center;
    justify-content: center;
    border-radius: 99px;
    background: var(--brand-purple-soft);
    color: var(--brand-purple);
  }

  .success h2 {
    margin: 1rem 0 0;
    font-size: 1.35rem;
    line-height: 1.35;
    letter-spacing: -0.02em;
  }

  .success h2:focus {
    outline: none;
  }

  .foot {
    padding: 1.6rem 0 1.8rem;
    color: var(--brand-muted);
    font-size: 0.78rem;
    text-align: center;
  }

  .foot p {
    margin: 0;
  }

  .foot-links {
    margin-top: 0.4rem !important;
  }

  .foot a {
    color: inherit;
    text-decoration: underline;
  }

  @media (prefers-reduced-motion: reduce) {
    .submit,
    .field input,
    .field select,
    .field textarea {
      transition: none;
    }
  }
</style>
