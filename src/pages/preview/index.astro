---
import BrandLayout from '../../layouts/BrandLayout.astro';
import BuiltWork from '../../components/brand/BuiltWork.astro';
import Closing from '../../components/brand/Closing.astro';
import Comparison from '../../components/brand/Comparison.astro';
import CustomerAndTeam from '../../components/brand/CustomerAndTeam.astro';
import Faq from '../../components/brand/Faq.astro';
import DayStory from '../../components/brand/DayStory.astro';
import Hero from '../../components/brand/Hero.astro';
import Industries from '../../components/brand/Industries.astro';
import Pillars from '../../components/brand/Pillars.astro';
import Process from '../../components/brand/Process.astro';
import Tested from '../../components/brand/Tested.astro';
import ToolsMap from '../../components/brand/ToolsMap.astro';
---

<BrandLayout
  title="Preview | Brackstone Digital"
  description="Hidden preview of the new Brackstone Digital homepage. This page is not for search engines."
  noindex
>
  <main class="preview">
    <Hero />
    <Pillars />
    <DayStory />
    <ToolsMap />
    <BuiltWork />
    <Process />
    <CustomerAndTeam />
    <Industries />
    <Comparison />
    <Tested />
    <Faq />
    <Closing />
  </main>
</BrandLayout>

<style is:global>
  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      .preview h1,
      .preview h2,
      .preview section:not(#day) article:not(.frame),
      .preview #how .step,
      .preview #both-sides .panel,
      .preview #tools .hub,
      .preview #comparison .table-wrap,
      .preview #tested .tester,
      .preview #faq details,
      .preview #closing .option,
      .preview .trust {
        animation: preview-rise linear both;
        animation-timeline: view();
        animation-range: entry 0% cover 28%;
      }
    }
  }

  @keyframes preview-rise {
    from { opacity: 0; transform: translateY(1.4rem); }
    to { opacity: 1; transform: none; }
  }
</style>
